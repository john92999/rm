FROM mcr.microsoft.com/dotnet/aspnet:8.0
RUN apt-get update && apt-get install -y unzip wget && apt-get clean
RUN wget https://github.com/nopSolutions/nopCommerce/releases/download/release-4.70.4/nopCommerce_4.70.4_NoSource_linux_x64.zip && unzip nopCommerce_4.70.4_NoSource_linux_x64.zip -d /var/www/nopCommerce && rm nopCommerce_4.70.4_NoSource_linux_x64.zip
WORKDIR /var/www/nopCommerce
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:5000
RUN chmod -R 755 .
EXPOSE 5000
ENTRYPOINT  ["dotnet", "Nop.Web.dll"]
